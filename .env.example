# Complete API URL, including the OpenAPI server prefix.
API_BASE_URL=http://localhost:3000/dev/

# UI application URL.
UI_BASE_URL=http://localhost:3000/

# Optional base URL used by BasePage.goto(). Takes precedence for UI tests.
DEV_URL=http://localhost:3000/

# Admin credentials for the login E2E test.
ADMIN_EMAIL=
TEST_PASSWORD=

# Employee login test (leave empty until an account is available).
EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD=

# Optional bearer token for protected API endpoints.
API_TOKEN=
